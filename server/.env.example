# Copy to server/.env and export before `mvn spring-boot:run`, or set on the host.
DATABASE_URL=jdbc:postgresql://localhost:5432/homevault
DATABASE_USER=homevault
DATABASE_PASSWORD=homevault

AUTH_MODE=device
# >= 32 random bytes, e.g. `openssl rand -base64 48`
AUTH_SECRET=
# Only for AUTH_MODE=supabase
AUTH_JWK_SET_URI=

# Key from a Google Cloud project WITH billing enabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
MODEL_TIMEOUT=40s
# Development without a key: GEMINI_MOCK=true serves canned items per room type
GEMINI_MOCK=false

QUOTA_FREE_PER_MONTH=3
QUOTA_PRO_PER_MONTH=300
# Global cost fuse: analyses per UTC day across all users (0 = off)
DAILY_BUDGET=2000
# Per-IP hourly limits on device registration and analysis
RATE_DEVICES_PER_HOUR=20
RATE_ANALYZE_PER_HOUR=120
# true only behind a proxy that overwrites X-Forwarded-For
TRUST_FORWARDED_FOR=false

# RevenueCat webhook (dashboard -> Integrations -> Webhooks -> Authorization header value).
# Empty = webhook endpoint disabled (503).
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=pro

# Play Integrity (App Check). off | log | enforce. Needs the Play Integrity API
# enabled on the Cloud project linked to the Play app and a service-account
# key file with access to it. Keep the JSON out of git.
APP_CHECK_MODE=off
APP_CHECK_PACKAGE=com.homevault.app
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=

# Cloud backup of PDF reports (stored in Postgres). Defaults: 20 reports,
# 8 MB each, 100 MB per device, transfer codes valid 15 minutes, purge after
# a year without activity.
#BACKUP_MAX_PER_USER=20
#BACKUP_MAX_FILE_BYTES=8388608
#BACKUP_MAX_TOTAL_BYTES=104857600
